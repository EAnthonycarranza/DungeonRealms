<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The game is always dark, in light and dark system modes alike. -->
    <!-- Theme applied while the process starts. Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme behind the Flutter UI while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/realm_night</item>
    </style>
</resources>
